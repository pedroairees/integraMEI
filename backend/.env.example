PORT=3333
HOST=127.0.0.1
# Endereço do frontend para os links de recuperação de senha do Supabase Auth.
APP_URL=http://localhost:3000
# Relatórios por e-mail: remetente verificado no seu provedor SMTP.
# Sem configuração, PDF/Excel continuam disponíveis para download.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORTS_FROM=
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Leitura de notas: Groq primeiro; Gemini somente como reserva. OpenAI não é chamada.
# Chaves secretas apenas no backend, nunca em NEXT_PUBLIC_* ou no Git.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Sem Groq configurado, tenta Gemini. Sem ambas, novos envios são bloqueados.
# PDFs com mais de 3 páginas seguem inteiros ao Gemini; nunca são truncados.
# No máximo 2 tentativas por provedor; orçamento total de leitura: 44 segundos.
# Em desenvolvimento, sem estas variáveis, reutiliza frontend/.env.local.
# Em produção, configure as variáveis acima no servidor e use HTTPS no proxy.
